<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hf="HexFall.UI">
    <ui:VisualElement class="hf-screen" picking-mode="Ignore"><ui:VisualElement class="hf-screen__main" picking-mode="Ignore"><ui:ScrollView class="hf-col register__col" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
        <ui:VisualElement class="hf-panel register__panel">
            <ui:Label text="Forge your wizard" class="hf-text--title" />
            <ui:Label text="One account keeps your eliminations, wins and rank." class="hf-text--sub" />
            <ui:VisualElement class="hf-field">
                <ui:Label text="WIZARD NAME" class="hf-field__label" />
                <ui:TextField name="name-field" class="hf-input" max-length="24" />
                <ui:Label name="name-help" class="hf-help hf-help--neutral" />
            </ui:VisualElement>
            <ui:VisualElement class="hf-field">
                <ui:Label text="EMAIL" class="hf-field__label" />
                <ui:TextField name="email-field" class="hf-input" placeholder-text="wizard@example.com" />
            </ui:VisualElement>
            <ui:VisualElement class="register__pair">
                <ui:VisualElement class="hf-field hf-gap-end">
                    <ui:Label text="PASSWORD" class="hf-field__label" />
                    <ui:TextField name="password-field" password="true" class="hf-input" />
                </ui:VisualElement>
                <ui:VisualElement class="hf-field">
                    <ui:Label text="CONFIRM" class="hf-field__label" />
                    <ui:TextField name="confirm-field" password="true" class="hf-input" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="register__rules">
                <ui:VisualElement name="rule-length" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="8+ characters" class="hf-rule__text" /></ui:VisualElement>
                <ui:VisualElement name="rule-upper" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Uppercase" class="hf-rule__text" /></ui:VisualElement>
                <ui:VisualElement name="rule-lower" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Lowercase" class="hf-rule__text" /></ui:VisualElement>
                <ui:VisualElement name="rule-digit" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Number" class="hf-rule__text" /></ui:VisualElement>
                <ui:VisualElement name="rule-symbol" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Symbol" class="hf-rule__text" /></ui:VisualElement>
                <ui:VisualElement name="rule-match" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Passwords match" class="hf-rule__text" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="error-label" class="hf-error" style="display: none; margin-top: -8px;" />
            <ui:Button name="register-submit" text="CREATE ACCOUNT" class="hf-btn hf-btn--primary" />
            <ui:VisualElement class="hf-link-row">
                <ui:Label text="Already have an account?" class="hf-text--muted" />
                <ui:Button name="login-link" text="Log in" class="hf-link" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView></ui:VisualElement></ui:VisualElement>
</ui:UXML>
