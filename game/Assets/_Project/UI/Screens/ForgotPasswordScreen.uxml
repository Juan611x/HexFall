<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hf="HexFall.UI">
    <ui:VisualElement class="hf-screen" picking-mode="Ignore"><ui:VisualElement class="hf-screen__main hf-screen__main--center" picking-mode="Ignore"><ui:ScrollView class="hf-col forgot__col" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
        <ui:VisualElement class="hf-panel forgot__panel">
            <ui:Label text="Reset your password" class="hf-text--title" />
            <ui:Label name="forgot-subtitle" class="hf-text--sub" />
            <ui:VisualElement name="email-step" class="forgot__step">
                <ui:VisualElement class="hf-field">
                    <ui:Label text="EMAIL" class="hf-field__label" />
                    <ui:TextField name="email-field" class="hf-input" placeholder-text="wizard@example.com" />
                </ui:VisualElement>
                <ui:Label name="email-error" class="hf-error" style="display: none;" />
                <ui:Button name="send-code" text="SEND CODE" class="hf-btn hf-btn--primary" />
            </ui:VisualElement>
            <ui:VisualElement name="code-step" class="forgot__step" style="display: none;">
                <ui:VisualElement class="verify__digits">
                    <ui:TextField name="digit-0" class="hf-input hf-digit" />
                    <ui:TextField name="digit-1" class="hf-input hf-digit" />
                    <ui:TextField name="digit-2" class="hf-input hf-digit" />
                    <ui:TextField name="digit-3" class="hf-input hf-digit" />
                    <ui:TextField name="digit-4" class="hf-input hf-digit" />
                    <ui:TextField name="digit-5" class="hf-input hf-digit" />
                </ui:VisualElement>
                <ui:VisualElement class="register__pair">
                    <ui:VisualElement class="hf-field hf-gap-end">
                        <ui:Label text="NEW PASSWORD" class="hf-field__label" />
                        <ui:TextField name="password-field" password="true" class="hf-input" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hf-field">
                        <ui:Label text="CONFIRM" class="hf-field__label" />
                        <ui:TextField name="confirm-field" password="true" class="hf-input" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="register__rules">
                    <ui:VisualElement name="rule-length" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="8+ characters" class="hf-rule__text" /></ui:VisualElement>
                    <ui:VisualElement name="rule-upper" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Uppercase" class="hf-rule__text" /></ui:VisualElement>
                    <ui:VisualElement name="rule-lower" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Lowercase" class="hf-rule__text" /></ui:VisualElement>
                    <ui:VisualElement name="rule-digit" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Number" class="hf-rule__text" /></ui:VisualElement>
                    <ui:VisualElement name="rule-symbol" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Symbol" class="hf-rule__text" /></ui:VisualElement>
                    <ui:VisualElement name="rule-match" class="hf-rule"><ui:VisualElement class="hf-rule__box" /><ui:Label text="Passwords match" class="hf-rule__text" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="code-error" class="hf-error" style="display: none;" />
                <ui:Button name="reset-submit" text="RESET PASSWORD" class="hf-btn hf-btn--primary" />
                <ui:VisualElement class="hf-link-row">
                    <ui:Button name="resend-button" class="hf-link" />
                    <ui:Button name="change-email-link" text="Use a different email" class="hf-link" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:ScrollView></ui:VisualElement></ui:VisualElement>
</ui:UXML>
