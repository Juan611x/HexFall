<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:hf="HexFall.UI">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">
        <hf:HexCrosshairElement name="crosshair" class="hud-crosshair" />
        <hf:InkPlayerHudElement name="player-cluster" class="hud-player">
            <ui:Label name="player-portrait" text="PORTRAIT" class="hud-player__portrait" picking-mode="Ignore" />
            <ui:Label name="player-name" text="Wizard" class="hud-player__name" picking-mode="Ignore" />
            <ui:Label name="player-health" text="100 / 100" class="hud-player__health" picking-mode="Ignore" />
        </hf:InkPlayerHudElement>
    </ui:VisualElement>
</ui:UXML>
