.hud-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hud-crosshair {
    width: 48px;
    height: 48px;
    color: #5eead4;
}

/* Player cluster, "ink and runes": a 400x130 design space; label offsets match InkPlayerHudElement. */
.hud-player {
    position: absolute;
    left: 16px;
    bottom: 14px;
    width: 400px;
    height: 130px;
}

.hud-player > Label {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/CinzelDecorative-Bold.ttf");
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.hud-player__portrait {
    left: 22px;
    top: 59px;
    width: 72px;
    -unity-text-align: middle-center;
    font-size: 8px;
    letter-spacing: 1px;
    color: #a39fc0;
}

.hud-player__name {
    left: 124px;
    top: 34px;
    font-size: 15px;
    color: #f5dca6;
}

.hud-player__health {
    left: 276px;
    top: 37px;
    width: 100px;
    -unity-text-align: upper-right;
    font-size: 12px;
    color: #fda4af;
}

/* Interact prompt (InkPromptElement): a 260x60 design space, bottom centre above the player cluster row. */
.hud-prompt {
    position: absolute;
    left: 50%;
    bottom: 150px;
    width: 260px;
    height: 60px;
    translate: -50% 0;
}

.hud-prompt > Label {
    position: absolute;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/CinzelDecorative-Bold.ttf");
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.8);
}

.hud-prompt__key {
    left: 14px;
    top: 13px;
    width: 40px;
    height: 34px;
    -unity-text-align: middle-center;
    font-size: 22px;
    color: #f5dca6;
}

.hud-prompt__text {
    left: 64px;
    top: 19px;
    width: 184px;
    height: 22px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    font-size: 15px;
    color: #f5dca6;
}

/* Floating damage numbers (DamagePopupLayer): centred on the hit point, scaled and faded from code. */
.damage-popup {
    position: absolute;
    margin: 0;
    padding: 0;
    translate: -50% -50%;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/PixelifySans-Bold.ttf");
    font-size: 42px;
    color: #fde68a;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: #1a1033;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.6);
}
