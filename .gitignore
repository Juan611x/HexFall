# =========================================================
# Unity (project lives in /game)
# =========================================================
/game/[Ll]ibrary/
/game/[Tt]emp/
/game/[Oo]bj/
/game/[Bb]uild/
/game/[Bb]uilds/
/game/[Ll]ogs/
/game/[Uu]ser[Ss]ettings/
/game/[Mm]emoryCaptures/
/game/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/game/[Aa]ssets/**/*.meta

# Autogenerated IDE / solution files
/game/.vs/
/game/.vscode/
/game/.idea/
/game/.consulo/
/game/*.csproj
/game/*.unityproj
/game/*.sln
/game/*.slnx
/game/*.suo
/game/*.tmp
/game/*.user
/game/*.userprefs
/game/*.pidb
/game/*.booproj
/game/*.svd
/game/*.pdb
/game/*.mdb
/game/*.opendb
/game/*.VC.db
/game/*.pidb.meta
/game/*.pdb.meta
/game/*.mdb.meta

# Unity crash reports and builds
/game/sysinfo.txt
/game/mono_crash.*
*.apk
*.aab
*.unitypackage
*.app

# Unity Starter Assets (Asset Store, non-standard EULA): kept local until its
# licence is confirmed for a public repository.
/game/[Aa]ssets/Starter Assets/
/game/[Aa]ssets/Starter Assets.meta
# Unity template readme (unused by HexFall); Starter Assets overwrites it with its own version.
/game/[Aa]ssets/TutorialInfo/
/game/[Aa]ssets/TutorialInfo.meta
/game/[Aa]ssets/Readme.asset
/game/[Aa]ssets/Readme.asset.meta

# Gradle cache (Android)
/game/.gradle/

# Packed addressables / streaming assets
/game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/game/[Aa]ssets/[Ss]treamingAssets/aa/*

# =========================================================
# Terraform (/infra)
# =========================================================
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.example.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Backend settings name the account; keep only the .example in git.
infra/**/backend.hcl
*.tfplan

# =========================================================
# Server / services (Node, Python, Go, .NET)
# =========================================================
node_modules/
dist/
coverage/
__pycache__/
*.py[cod]
.venv/
venv/
bin/
obj/
*.zip

# =========================================================
# Secrets and local environment
# =========================================================
.env
.env.*
!.env.example
*.pem
*.key
.aws/

# =========================================================
# OS / editors
# =========================================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# =========================================================
# Local tooling indexes
# =========================================================
.codegraph/
.atl/

# Reusable modules do not commit a lock file; root modules do.
infra/modules/**/.terraform.lock.hcl

# draw.io backup files
*.drawio.bkp
