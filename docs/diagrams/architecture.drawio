        <mxCell id="s3tags" value="Block Public Access on · ACLs disabled · SSE-S3&lt;br&gt;Holds the WebGL build and the generated &lt;code&gt;config.json&lt;/code&gt;&lt;br&gt;Read only by CloudFront (OAC, &lt;code&gt;AWS:SourceArn&lt;/code&gt; = this distribution)" style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#545B64;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;align=left;" vertex="1" parent="client">
          <mxGeometry x="20" y="108" width="470" height="55" as="geometry" />
