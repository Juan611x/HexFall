<mxfile host="Electron">
  <diagram name="Architecture" id="hexfall-architecture">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;HexFall — Architecture (dev)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#545B64&quot;&gt;Unity WebGL client on S3 + CloudFront, player accounts in Amazon Cognito with unique wizard names (Lambda + DynamoDB), everything provisioned with Terraform · game server planned&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dev" value="Developer workstation" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;fontColor=#5A6C86;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="320" height="855" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;game/Builds/WebGL&lt;/b&gt;&lt;br&gt;index.html + Brotli &lt;code&gt;.br&lt;/code&gt; files (~18 MB), from &lt;code&gt;tools/build-webgl.ps1&lt;/code&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#C5CCD3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="dev">
          <mxGeometry x="25" y="50" width="270" height="64" as="geometry" />
        </mxCell>
        <mxCell id="tf" value="&lt;b&gt;Terraform CLI&lt;/b&gt;&lt;br&gt;&lt;code&gt;infra/envs/dev&lt;/code&gt; → modules &lt;code&gt;static-site&lt;/code&gt;, &lt;code&gt;user-pool&lt;/code&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#C5CCD3;fillColor=#FFFFFF;fontColor=#232F3E;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="dev">
          <mxGeometry x="25" y="330" width="270" height="64" as="geometry" />
        </mxCell>
