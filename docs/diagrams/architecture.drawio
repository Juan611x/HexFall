        </mxCell>
        <mxCell id="pool" value="&lt;b&gt;User pool&lt;/b&gt; hexfall-dev-players&lt;br&gt;email sign-in · code verification" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#DD344C;shape=mxgraph.aws4.cognito;" vertex="1" parent="cognito">
          <mxGeometry x="20" y="36" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="poolnote" value="&lt;b&gt;User pool:&lt;/b&gt; email as username, auto-verified by code, wizard name in &lt;code&gt;preferred_username&lt;/code&gt; (unique, DD-018), password policy 8+ with upper/lower/number/symbol, default email sender (about 50 emails/day).&lt;br&gt;&lt;b&gt;App client:&lt;/b&gt; public, no secret, &lt;code&gt;USER_PASSWORD_AUTH&lt;/code&gt; + refresh tokens, no Hosted UI. The only Lambda is the Pre Sign-up trigger below." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#545B64;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;align=left;" vertex="1" parent="cognito">
          <mxGeometry x="20" y="92" width="470" height="66" as="geometry" />
        </mxCell>
