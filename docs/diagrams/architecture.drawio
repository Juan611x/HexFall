          <mxGeometry x="30" y="415" width="510" height="195" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="&lt;b&gt;Pre Sign-up Lambda&lt;/b&gt;&lt;br&gt;hexfall-dev-names-trigger" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#ED7100;shape=mxgraph.aws4.lambda_function;" vertex="1" parent="wiz">
          <mxGeometry x="180" y="34" width="48" height="48" as="geometry" />
        </mxCell>
        <mxCell id="ddb" value="&lt;b&gt;DynamoDB table&lt;/b&gt;&lt;br&gt;hexfall-dev-wizard-names" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;strokeColor=none;dashed=0;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;labelPosition=right;verticalLabelPosition=middle;verticalAlign=middle;align=left;spacingLeft=8;fillColor=#C925D1;shape=mxgraph.aws4.dynamodb;" vertex="1" parent="wiz">
          <mxGeometry x="180" y="118" width="48" height="48" as="geometry" />
