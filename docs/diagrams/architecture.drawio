      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:20px&quot;&gt;HexFall — Architecture (dev)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#545B64&quot;&gt;Unity WebGL client on S3 + CloudFront, player accounts in Amazon Cognito with unique wizard names and a public guest name check (Lambda + DynamoDB), everything provisioned with Terraform · game server planned&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="1200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="dev" parent="1" style="outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;verticalAlign=top;align=left;spacingLeft=30;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#7D8998;fillColor=none;fontColor=#5A6C86;dashed=0;" value="Developer workstation" vertex="1">
