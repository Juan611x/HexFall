        <mxCell id="lg-ln2" edge="1" parent="legend" style="edgeStyle=orthogonalEdgeStyle;html=1;jettySize=auto;orthogonalLoop=1;labelBackgroundColor=#FFFFFF;rounded=1;strokeColor=#C925D1;strokeWidth=1.5;dashed=1;dashPattern=4 3;endArrow=block;endFill=1;fontSize=10;fontColor=#8E1A94;" value="">
