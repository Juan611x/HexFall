          <mxGeometry height="22" width="290" x="400" y="80" as="geometry" />
        </mxCell>
        <mxCell id="lg-ln3" edge="1" parent="legend" style="edgeStyle=orthogonalEdgeStyle;html=1;jettySize=auto;orthogonalLoop=1;labelBackgroundColor=#FFFFFF;rounded=1;strokeColor=#545B64;strokeWidth=1;endArrow=block;endFill=1;fontSize=10;fontColor=#545B64;" value="">
