        <mxCell id="p-meta" value="&lt;div style=&quot;box-sizing:border-box;width:100%;height:100%;padding:8px 10px;font-size:11px;line-height:1.35&quot;&gt;&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:6px&quot;&gt;Object metadata set on upload&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#232F3E;color:#FFFFFF;text-align:left;padding:4px 6px;border:1px solid #232F3E;width:34%;&quot;&gt;File&lt;/th&gt;&lt;th style=&quot;background:#232F3E;color:#FFFFFF;text-align:left;padding:4px 6px;border:1px solid #232F3E;width:40%;&quot;&gt;Content-Type&lt;/th&gt;&lt;th style=&quot;background:#232F3E;color:#FFFFFF;text-align:left;padding:4px 6px;border:1px solid #232F3E;width:26%;&quot;&gt;Content-Encoding&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;&lt;b&gt;*.wasm.br&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;application/wasm&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;br&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;&lt;b&gt;*.framework.js.br&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;application/javascript&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;br&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;&lt;b&gt;*.data.br&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;application/octet-stream&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;br&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;&lt;b&gt;*.loader.js&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;application/javascript&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;&lt;b&gt;index.html&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;text/html&lt;/td&gt;&lt;td style=&quot;padding:5px 6px;border:1px solid #C5CCD3;vertical-align:top;&quot;&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;overflow=fill;rounded=0;strokeColor=#C5CCD3;fillColor=#FFFFFF;fontColor=#232F3E;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
